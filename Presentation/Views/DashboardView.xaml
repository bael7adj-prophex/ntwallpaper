<UserControl x:Class="NTWallpaper.Presentation.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NTWallpaper.Presentation.ViewModels"
             xmlns:conv="clr-namespace:NTWallpaper.Presentation.Converters"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:ByteSizeConverter x:Key="Bytes" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
            <TextBlock Text="{Binding StatusMessage}" Margin="20,8,0,0" Foreground="{DynamicResource ForegroundMutedBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Current wallpaper" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,12" />
                    <Border Background="#FF1A1A1A" CornerRadius="6" Height="280">
                        <TextBlock Text="Preview" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ForegroundMutedBrush}" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="New Wallpaper" Style="{StaticResource PrimaryButton}" Command="{Binding NewWallpaperCommand}"
                                CommandParameter="{Binding ElementName=GroupsList, Path=SelectedItem.Id}" />
                        <Button Content="Pause All" Style="{StaticResource SecondaryButton}" Command="{Binding PauseAllCommand}" Margin="8,0,0,0" />
                        <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Grid.Column="1">
                <StackPanel>
                    <TextBlock Text="Statistics" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Cached images" Foreground="{DynamicResource ForegroundMutedBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding ImageCount}" Foreground="{DynamicResource ForegroundBrush}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="Cache size" Foreground="{DynamicResource ForegroundMutedBrush}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CacheSizeBytes, Converter={StaticResource Bytes}}" Foreground="{DynamicResource ForegroundBrush}" FontWeight="SemiBold" />
                    </Grid>
                    <Separator Margin="0,12" Background="{DynamicResource BorderBrush}" />
                    <TextBlock Text="Groups" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" Margin="0,0,0,8" />
                    <ListBox x:Name="GroupsList" ItemsSource="{Binding Groups}" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource ForegroundBrush}" Height="160">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource ForegroundBrush}" />
                                        <TextBlock Text="{Binding TargetCount, StringFormat='{}{0} target(s)'}" Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding NextRunDisplay}" Foreground="{DynamicResource ForegroundMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
